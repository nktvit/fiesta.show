{
  "name": "movie-streamer",
  "version": "0.0.0",
  "scripts": {
    "prebuild": "node scripts/set-env.js",
    "start": "ng serve",
    "build": "npm install --prefix tv && npm run build --prefix tv && ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "eval:moderation": "node --env-file=.env.local scripts/moderation-evals.mjs"
  },
  "browserslist": [
    "last 2 versions",
    "> 0.5%",
    "not dead",
    "not IE 11",
    "iOS >= 15",
    "Safari >= 15"
  ],
  "private": true,
  "dependencies": {
    "@angular/animations": "^20.3.18",
    "@angular/common": "^20.3.18",
    "@angular/compiler": "^20.3.18",
    "@angular/core": "^20.3.18",
    "@angular/forms": "^20.3.18",
    "@angular/platform-browser": "^20.3.18",
    "@angular/platform-browser-dynamic": "^20.3.18",
    "@angular/router": "^20.3.18",
    "@tailwindcss/container-queries": "^0.1.1",
    "@tailwindcss/typography": "^0.5.15",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.4",
    "@vercel/analytics": "^1.5.0",
    "@vercel/functions": "^1.6.0",
    "@vercel/node": "^5.1.14",
    "@vercel/speed-insights": "^2.0.0",
    "ai": "^7.0.93",
    "flowbite": "^3.1.2",
    "hls.js": "^1.6.16",
    "rxjs": "~7.8.1",
    "tslib": "^2.8.1",
    "zod": "^4.5.4",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^20.3.23",
    "@angular/cli": "^20.3.23",
    "@angular/compiler-cli": "^20.3.18",
    "@types/jasmine": "~5.1.4",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.9.3",
    "autoprefixer": "^10.4.20",
    "jasmine-core": "~5.4.0",
    "karma": "~6.4.4",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.1",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "typescript": "5.9.3"
  }
}
