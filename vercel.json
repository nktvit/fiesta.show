{
  "version": 2,
  "functions": {
    "api/suggestions.js": {
      "memory": 1024,
      "maxDuration": 15
    },
    "api/tmdb.js": {
      "memory": 1024,
      "maxDuration": 15
    },
    "api/movie.js": {
      "memory": 1024,
      "maxDuration": 15
    },
    "api/omdb.js": {
      "memory": 1024,
      "maxDuration": 15
    },
    "api/stream.js": {
      "memory": 1024,
      "maxDuration": 30
    },
    "api/subs.js": {
      "memory": 1024,
      "maxDuration": 15
    },
    "api/likes.js": {
      "memory": 1024,
      "maxDuration": 15
    },
    "api/comments.js": {
      "memory": 1024,
      "maxDuration": 15
    },
    "api/music.js": {
      "memory": 1024,
      "maxDuration": 30
    }
  },
  "buildCommand": "npm run build",
  "headers": [
    {
      "source": "/vendor/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/((?!.*\\.[a-zA-Z0-9]{1,5}$).*)",
      "headers": [{ "key": "Vary", "value": "User-Agent" }]
    }
  ],
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/lite/(.*)", "destination": "/lite/$1" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
